{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://new-earth.uk/schemas/gaia/project-registry.schema.json",
  "title": "GAIA Project Registry",
  "type": "object",
  "required": ["projects"],
  "properties": {
    "projects": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["name", "root", "access", "approved_extensions"],
        "properties": {
          "name": {"type": "string"},
          "root": {"type": "string"},
          "access": {"const": "read_only"},
          "approved_extensions": {"type": "array", "items": {"type": "string"}},
          "excluded_directories": {"type": "array", "items": {"type": "string"}},
          "excluded_filenames": {"type": "array", "items": {"type": "string"}},
          "important_paths": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
